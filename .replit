modules = ["python-3.11"]

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd src && /home/runner/workspace/.pythonlibs/bin/flet run --web --host 0.0.0.0 --port 5000 -a assets main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd src && /home/runner/workspace/.pythonlibs/bin/flet run --web --host 0.0.0.0 --port 5000 -a assets main.py"]

[userenv]

[userenv.shared]
FLET_SECRET_KEY = "123456"
